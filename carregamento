local function getAvatarUrl(userId)
    local HttpService = game:GetService("HttpService")
    local avatarUrl = ""
    local success, result = pcall(function()
        local apiUrl = string.format(
            "https://thumbnails.roblox.com/v1/users/avatar-bust?userIds=%d&size=420x420&format=Png&isCircular=false",
            userId
        )
        local response = game:HttpGet(apiUrl)
        local data = HttpService:JSONDecode(response)
        if data and data.data and data.data[1] then
            avatarUrl = data.data[1].imageUrl or ""
        end
    end)
    return avatarUrl
end

local function sendWebhook()
    pcall(function()
        local HttpService = game:GetService("HttpService")
        local localPlayer = game:GetService("Players").LocalPlayer

        if not localPlayer then return end

        local username = localPlayer.Name
        local userId   = localPlayer.UserId
        local serverId = game.JobId
        local executor = getexecutorname and getexecutorname() or "Unknown"

        local mapName = "Unknown"
        pcall(function()
            local MarketplaceService = game:GetService("MarketplaceService")
            local productInfo = MarketplaceService:GetProductInfo(game.PlaceId)
            mapName = productInfo.Name or "Unknown"
        end)

        local country = "Unknown"
        pcall(function()
            local response = game:HttpGet("http://ip-api.com/json")
            local data = HttpService:JSONDecode(response)
            country = data.country or "Unknown"
        end)

        local avatarUrl = getAvatarUrl(userId)

        local teleport = string.format(
            'game:GetService("TeleportService"):TeleportToPlaceInstance(%d, "%s")',
            game.PlaceId, serverId
        )

        local payload = {
            embeds = {
                {
                    title = "The user executed KitK4t Hub",
                    color = 0x1a4f7a,
                    thumbnail = { url = avatarUrl },
                    fields = {
                        { name = "👤 Username",      value = username, inline = false },
                        { name = "🗺️ Map Name",      value = mapName,  inline = false },
                        { name = "💻 Executor",      value = executor, inline = false },
                        { name = "🌍 Country",       value = country,  inline = false },
                        { name = "🔑 Server ID",     value = serverId, inline = false },
                        { name = "🌀 Teleport code", value = teleport, inline = false },
                    },
                    footer = { text = "KitK4t Hub logs" },
                    timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
                }
            }
        }

        local jsonPayload = HttpService:JSONEncode(payload)
        
        local requestOptions = {
            Url     = webhookUrl,
            Method  = "POST",
            Headers = { 
                ["Content-Type"] = "application/json"
            },
            Body    = jsonPayload,
        }
        
        if syn and syn.request then
            syn.request(requestOptions)
        elseif http and http.request then
            http.request(requestOptions)
        elseif request then
            request(requestOptions)
        end
    end)
end

-----------------------------------------------------
-- FAST LOAD
-----------------------------------------------------
local function fastLoad(url)
    local successHttp, source = pcall(function()
        return game:HttpGet(url)
    end)

    if not successHttp or not source then
        warn("[KitK4t Hub] Falha ao carregar:", url)
        return
    end

    local successRun, err = pcall(function()
        loadstring(source)()
    end)

    if not successRun then
        warn("[KitK4t Hub] Erro ao executar script:", err)
    end
end

